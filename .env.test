# Used by unit and e2e tests (see test/setup-env.ts) — a separate database
# from both .env's dev DB and my-home's own databases, so test runs never
# touch real data and can freely truncate between tests.
DATABASE_URL=postgres://home_manager:home_manager@127.0.0.1:5432/hearth_backend_test

JWT_SECRET=test-secret-not-for-production-use-only-in-ci-and-local-tests
JWT_EXPIRES_IN=30d

APP_URL=http://localhost:5173
