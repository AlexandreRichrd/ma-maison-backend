// Prisma schema for the Hearth backend.
//
// This is a 1:1 port of my-home/app/db/schema.ts (Drizzle). Table names,
// column names, types, defaults, and constraints are preserved exactly via
// @@map/@map — model and field names are just renamed to Prisma/TS
// convention (PascalCase models, camelCase fields). No data model redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// auth domain: households, users, invites, email_verifications, password_resets
// ---------------------------------------------------------------------------

model Household {
  id          String   @id @default(uuid()) @db.Uuid
  memberOrder String[] @default([]) @map("member_order") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  users    User[]
  invites  Invite[]
  settings HouseholdSettings?

  @@map("households")
}

// One row per household (in practice, at most one row ever, since this app
// is single-household), created lazily on the first PATCH /settings rather
// than by bootstrap-household.ts — see SettingsService.getEffective(),
// which falls back to hardcoded defaults when this row doesn't exist yet, so
// a fresh install behaves exactly as it did when these were env vars. See
// CLAUDE.md's Climate alerts section (issue #11) for why this exists as a
// typed table rather than a KV settings store or columns on Household.
model HouseholdSettings {
  householdId String @id @map("household_id") @db.Uuid

  climateAlertEnabled          Boolean @default(true) @map("climate_alert_enabled")
  climateAlertMarginC          Float   @default(0.5) @map("climate_alert_margin_c")
  climateAlertIndoorThresholdC Float   @default(24) @map("climate_alert_indoor_threshold_c")
  climateAlertCooldownMinutes  Int     @default(120) @map("climate_alert_cooldown_minutes")
  // CLIMATE_ALERT_HYSTERESIS_C stays an env var, not a column here — see
  // CLAUDE.md's Climate alerts section: a tuning knob for false-positive/
  // flap behaviour, not something a household member would reasonably want
  // to change from the UI.
  climateSummaryRetentionDays  Int     @default(7) @map("climate_summary_retention_days")

  // Household-chosen display name per sensor role — null means "use the
  // frontend's hardcoded default" (see settings-api.server.ts's
  // resolveSensorLabel() in my-home, issue #12). Two nullable columns, not
  // a device-name-keyed map: there are exactly two known sensor roles
  // (INDOOR_DEVICE/OUTDOOR_DEVICE, currently duplicated as hardcoded
  // constants in both repos), a small fixed set that doesn't justify a
  // separate table or a jsonb blob.
  indoorSensorLabel  String? @map("indoor_sensor_label")
  outdoorSensorLabel String? @map("outdoor_sensor_label")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_settings")
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  householdId          String    @map("household_id") @db.Uuid
  email                String    @unique
  passwordHash         String    @map("password_hash")
  name                 String
  avatarKey            String    @map("avatar_key")
  // Null until the /activate link is clicked. Login is refused until then.
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamptz(6)
  // Whether ClimateAlertMailListener emails this user on a fired alert —
  // the one per-user setting in issue #11, everything else being
  // household-wide (see HouseholdSettings). Defaults true so a fresh
  // install and every existing user keep today's "everyone gets alerts"
  // behaviour unchanged.
  receiveClimateAlerts Boolean   @default(true) @map("receive_climate_alerts")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  choreCompletions   ChoreCompletion[]
  anchoredChores     Chore[]
  sentInvites        Invite[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@map("users")
}

model Invite {
  id              String    @id @default(uuid()) @db.Uuid
  householdId     String    @map("household_id") @db.Uuid
  // Null only for the invite the bootstrap command issues against an empty
  // database, before any user exists to be the inviter. Every other invite
  // is created by InvitesService.create() on behalf of a signed-in user, so
  // this stays non-null for the entire life of the app past that first row.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  email           String
  token           String    @unique
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@map("invites")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// A separate table from EmailVerification, not the same table with a type
// discriminator — same reasoning that already keeps Invite apart from
// EmailVerification despite the identical token/expiry/used-marker shape.
// A reset token controls the credential itself, not just a verified flag,
// so keeping it on its own table means a query can never accidentally
// match the wrong kind of token.
model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// shopping domain: shopping_lists, shopping_items
// ---------------------------------------------------------------------------

model ShoppingList {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  items ShoppingItem[]

  @@map("shopping_lists")
}

model ShoppingItem {
  id             String   @id @default(uuid()) @db.Uuid
  listId         String   @map("list_id") @db.Uuid
  name           String
  quantity       Decimal  @db.Decimal
  unit           Unit
  checked        Boolean  @default(false)
  sourceRecipeId String?  @map("source_recipe_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  list         ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  sourceRecipe Recipe?      @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)

  @@map("shopping_items")
}

// ---------------------------------------------------------------------------
// recipes domain: recipes, recipe_ingredients, recipe_steps
// ---------------------------------------------------------------------------

// Closed set of measurement units, shared by recipe_ingredients.unit and
// shopping_items.unit — see CLAUDE.md's Database section. UNITE is a bare
// count with no real unit (e.g. "2 oignons"), what used to be an empty
// string.
enum Unit {
  G
  KG
  ML
  L
  CUILLERE_A_CAFE
  CUILLERE_A_SOUPE
  PINCEE
  GOUSSE
  TRANCHE
  SACHET
  PAQUET
  BOITE
  POT
  BOUTEILLE
  TETE
  DOUZAINE
  MICHE
  UNITE

  @@map("unit")
}

model Recipe {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  servings  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  ingredients  RecipeIngredient[]
  steps        RecipeStep[]
  sourcedItems ShoppingItem[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String   @id @default(uuid()) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  name      String
  quantity  Decimal  @db.Decimal
  unit      Unit
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

model RecipeStep {
  id        String   @id @default(uuid()) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  text      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_steps")
}

// ---------------------------------------------------------------------------
// chores domain: chores, chore_completions
// ---------------------------------------------------------------------------

enum AssignmentMode {
  ROTATING
  PINNED

  @@map("assignment_mode")
}

// DAY = occurs every frequencyValue days, WEEK = occurs every
// frequencyValue weeks (1 = weekly, 2 = biweekly, etc). Both frequency
// fields are always populated — never a nullable pair per unit; see
// rotation.service.ts for the single periodDays formula this feeds.
enum FrequencyUnit {
  DAY
  WEEK

  @@map("frequency_unit")
}

model Chore {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  frequencyUnit  FrequencyUnit  @map("frequency_unit")
  frequencyValue Int            @map("frequency_value")
  assignmentMode AssignmentMode @map("assignment_mode")
  // The calendar date this chore first occurred. Every later occurrence is
  // derived from this by rotation.service.ts — never a separately stored
  // schedule. For frequencyUnit=WEEK this must be a Monday (enforced by
  // ChoresService on create/update, not here — see its comment) so weekly
  // chores stay aligned with the persistent weekly block in the UI.
  anchorDate     DateTime       @map("anchor_date") @db.Date
  // Dual meaning depending on assignmentMode: for PINNED, the permanent
  // assignee; for ROTATING, who was assigned on anchorDate (occurrence
  // 0) — later occurrences alternate from there. One column instead of two
  // nullable ones (a chore is never in a state where both or neither
  // apply, so there's nothing a separate nullable pair would guard that
  // this doesn't already guarantee).
  anchorUserId   String         @map("anchor_user_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Restrict, not Cascade: a chore config is household-level, not the
  // anchor user's own data — it shouldn't vanish (or drag its completion
  // history down with it) if a remove-user flow is ever added.
  anchorUser  User              @relation(fields: [anchorUserId], references: [id], onDelete: Restrict)
  completions ChoreCompletion[]
  subtasks    ChoreSubtask[]

  @@map("chores")
}

// Subtasks inherit everything from their parent chore — no frequency, no
// assignee of their own. A chore is complete when every one of its
// subtasks is complete (see ChoreCompletion) — adding or removing a
// subtask changes what "complete" means for every past occurrence too,
// same deliberate tradeoff as editing a chore's schedule after
// completions exist (see CLAUDE.md's Chore rotation section).
model ChoreSubtask {
  id        String   @id @default(uuid()) @db.Uuid
  choreId   String   @map("chore_id") @db.Uuid
  label     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  chore       Chore             @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completions ChoreCompletion[]

  @@map("chore_subtasks")
}

model ChoreCompletion {
  id             String   @id @default(uuid()) @db.Uuid
  choreId        String   @map("chore_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  // NULL for a chore with no subtasks (current/original behaviour) — a
  // chore with subtasks has one completion row per subtask, never a
  // parent-level row of its own; "the whole chore is done" is always
  // derived (see cleaning.service.ts), not stored.
  subtaskId      String?  @map("subtask_id") @db.Uuid
  // The calendar date the occurrence starts, anchor-aligned — NOT the
  // date the user happened to tick the box. For a WEEK-unit chore this is
  // always a Monday (the only date rotation.service.ts ever computes an
  // occurrence for).
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  completedAt    DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  chore   Chore         @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtask ChoreSubtask? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  // The *real* uniqueness guarantee is two hand-written partial unique
  // indexes (chore_id, occurrence_date) WHERE subtask_id IS NULL and
  // (chore_id, subtask_id, occurrence_date) WHERE subtask_id IS NOT NULL —
  // see …_rekey_chore_completions_drop_iso_week's migration.sql. A single
  // @@unique here can't express "unique treating NULL as a real value",
  // and Prisma's schema DSL has no partial-index syntax, so this is
  // deliberate, documented schema.prisma/DB drift (same precedent as the
  // Migration history note in CLAUDE.md).
  @@map("chore_completions")
}

// ---------------------------------------------------------------------------
// climate domain: measures
// ---------------------------------------------------------------------------

// One row per MQTT reading forwarded by the household's Pi bridge (separate
// repo, see intranet's pi/ — not this API's concern how readings get
// collected). A device that reports temperature and humidity together
// produces two rows, not one wide row — type is a plain string rather than
// a DB enum, so a new sensor kind is a new string value, not a migration.
// Append-only — no updatedAt, rows are never modified after insert.
model Measure {
  id         String   @id @default(uuid()) @db.Uuid
  deviceName String   @map("device_name")
  type       String
  value      String
  // When the Pi read the value off MQTT, not when this row was inserted —
  // the two can diverge if the Pi buffers offline (see pi/'s retention
  // config) and forwards a backlog once connectivity returns.
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deviceName, type, recordedAt])
  @@map("measures")
}

// One row per (device, measure type, local calendar day) — written nightly
// by ClimateSummaryService from that day's raw measures, kept indefinitely
// (unlike measures, which are purged after CLIMATE_SUMMARY_RETENTION_DAYS).
// `date` is a Europe/Paris calendar day, not a UTC one — see
// src/climate/paris-time.util.ts. The @@unique is what makes the nightly
// job idempotent: re-running for a day upserts the same row instead of
// duplicating it. No row is ever written for a device+type with zero
// readings that day (a sensor offline for the day) — the aggregation
// query's GROUP BY only emits groups that have at least one row.
model DailySummary {
  id          String   @id @default(uuid()) @db.Uuid
  deviceName  String   @map("device_name")
  type        String
  date        DateTime @db.Date
  min         Decimal  @db.Decimal
  max         Decimal  @db.Decimal
  avg         Decimal  @db.Decimal
  sampleCount Int      @map("sample_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([deviceName, type, date])
  @@map("daily_summaries")
}

// ---------------------------------------------------------------------------
// reminders domain: reminders
// ---------------------------------------------------------------------------

model Reminder {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  dueAt       DateTime  @map("due_at") @db.Timestamptz(6)
  doneAt      DateTime? @map("done_at") @db.Timestamptz(6)
  // Can name either or both users — a household-of-two array, same pattern
  // as households.member_order. No FK: an array column can't declare one,
  // so a removed user just leaves a dangling id here (harmless — chip
  // lookups fall through to "no chip" for an id that no longer resolves).
  assigneeIds String[]  @default([]) @map("assignee_ids") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("reminders")
}
