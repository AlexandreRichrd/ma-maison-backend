# Copy to .env for local development. In production these are provided by
# compose.yml / the container environment instead.

# Own database on the same Postgres server my-home uses — never point this
# at my-home's `home_manager` (or `home_manager_test`) databases. Those are
# Drizzle-managed; pointing Prisma's migration tooling at them risks a
# drift-reset against real dev data. Create it once with:
#   docker exec <postgres-container> psql -U home_manager -d postgres -c "CREATE DATABASE hearth_backend;"
DATABASE_URL=postgres://home_manager:home_manager@127.0.0.1:5432/hearth_backend

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# SMTP for outgoing mail (invites, account activation). If SMTP_HOST is
# unset, emails are logged to the console instead of sent — fine for local
# dev, required in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Hearth <no-reply@example.com>"

# Base URL used to build links in emails (invite, account activation).
# Points at the frontend, not this API.
APP_URL=http://localhost:5173
