# Copy to .env for local development. In production these are provided by
# compose.yml / the container environment instead.

# Same physical database my-home's Drizzle setup uses — during the
# incremental migration, sections that haven't been ported to this API yet
# (Cleaning, Recipes, Reminders, Household) still read/write these tables
# directly via Drizzle. Do NOT run `prisma migrate` against it — the schema
# is Drizzle-managed; this API only ever queries through Prisma Client here,
# never migrates. `hearth_backend_test` (a separate database, see
# .env.test) is the only one Prisma's own migrations ever touch.
DATABASE_URL=postgres://home_manager:home_manager@127.0.0.1:5432/home_manager

# openssl rand -hex 32
# Must be the exact same value as my-home's JWT_SECRET — my-home verifies
# this API's tokens locally (see my-home's auth.server.ts) rather than
# calling back for every request, so both sides need to share the key.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# SMTP for outgoing mail (invites, account activation). If SMTP_HOST is
# unset, emails are logged to the console instead of sent — fine for local
# dev, required in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Hearth <no-reply@example.com>"

# Base URL used to build links in emails (invite, account activation).
# Points at the frontend, not this API.
APP_URL=http://localhost:5173
