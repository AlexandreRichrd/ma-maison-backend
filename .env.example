# Copy to .env for local development. In production these are provided by
# compose.yml / the container environment instead.

# Same physical database my-home's Drizzle setup uses. The incremental
# migration off my-home's Drizzle-backed backend is done — every route
# there now goes through this API. my-home keeps an isolated Drizzle setup
# solely for a local dev-seeding script (see my-home/CLAUDE.md's Database
# section); it doesn't touch schema, so it has no bearing on this API's own
# `prisma migrate` usage, which is the normal workflow here (see this
# repo's CLAUDE.md's migration history note for how the initial schema —
# originally created by Drizzle — was baselined).
DATABASE_URL=postgres://home_manager:home_manager@127.0.0.1:5432/home_manager

# RS256 keypair — this service signs with the private key, any client
# (my-home today, a mobile app later) verifies with the public key. Unlike
# the old shared JWT_SECRET, JWT_PUBLIC_KEY is not a secret: rotating the
# keypair means updating it here and wherever it's copied to verify, but a
# leak of the public key alone can't be used to forge a token.
#
# Generate a keypair (PKCS#8 private key, matching public key):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#
# Both PEM files need to become single-line values with literal \n in
# place of real newlines before pasting here — real newlines don't survive
# every environment this travels through (Docker Compose, VPS shell/
# systemd). One way to convert:
#   awk 'BEGIN{ORS="\\n"} {print}' private.pem
#
# JWT_PUBLIC_KEY is also what goes in my-home's own JWT_PUBLIC_KEY — copy
# the same value to both .env files (see my-home/.env.example).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=30d

# SMTP for outgoing mail (invites, account activation). If SMTP_HOST is
# unset, emails are logged to the console instead of sent — fine for local
# dev, required in production.
#
# Production mailbox: contact@aureus-lab.fr, hosted on OVH's Zimbra, with
# SPF/DKIM/DMARC already passing for that domain. Port 587 (STARTTLS) not
# 25 — outbound 25 is blocked on the OVH VPS this runs on. SMTP_PASS is the
# mailbox password, from whoever manages the OVH Zimbra account — never
# committed.
#
# There's no separate MAIL_FROM: the From header is always built from
# SMTP_USER ("Hearth" <contact@aureus-lab.fr>), since DMARC alignment
# checks From against the authenticated sending mailbox — letting them
# diverge is how mail ends up in spam.
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=contact@aureus-lab.fr
# SMTP_PASS=

# Base URL used to build links in emails (invite, account activation).
# Points at the frontend, not this API.
APP_URL=http://localhost:5173

# Static bearer token the household's Pi bridge (separate repo, see
# intranet's pi/) sends on POST /climate/measures. Not a user JWT — this
# route is @Public() and guarded instead by DeviceAuthGuard, which compares
# the Authorization header against this value. Generate with:
#   openssl rand -hex 32
CLIMATE_INGEST_TOKEN=

# Raw-measure retention (how many days of `measures` rows the nightly job
# keeps before deleting them) and the cool-down/close-up window-alert
# margin/indoor-threshold/cooldown/enabled switch used to live here too —
# issue #11 moved them into household_settings, editable from the
# Household settings card, since a UI now exists to change them without a
# redeploy. See CLAUDE.md's Climate alerts section.

# Hysteresis alone stays an env var — a flap-prevention tuning knob for the
# cool-down/close-up alert (see CLAUDE.md's Climate alerts section), not
# something a household member would reasonably want to change from the
# UI. Defaults to 0.3 if unset.
# CLIMATE_ALERT_HYSTERESIS_C=0.3

# The Alexa skill's application id (amzn1.ask.skill.…), from the skill's
# Endpoint tab in the Alexa developer console. AlexaSignatureGuard checks
# incoming requests are addressed to this specific skill, as defense-in-depth
# on top of Amazon's own request signature — see CLAUDE.md's Alexa section.
ALEXA_SKILL_ID=

# The skill's OAuth client credentials for the outbound Proactive Events
# API (issue #14) — from the skill's Permissions tab in the Alexa developer
# console (enable "Send Alexa Events" there first). Distinct from
# ALEXA_SKILL_ID above: that's the application id checked on inbound
# requests, these are used to obtain an LWA access token for outbound
# calls. See CLAUDE.md's Alexa section for the exact token request shape.
ALEXA_LWA_CLIENT_ID=
ALEXA_LWA_CLIENT_SECRET=
